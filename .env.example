# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-random-secret

# Host port exposed by Docker Compose.
APP_PORT=3000

# From inside Docker, host.docker.internal reaches an LLM API on the host.
# Replace this with the public/internal URL of the API in production.
LLM_API_BASE_URL=http://host.docker.internal:8000

# debug, info, warn, error, fatal, or unknown
RAILS_LOG_LEVEL=info
